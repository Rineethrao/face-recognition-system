{
  "app": {
    "name": "Core Face Recognition Engine",
    "debug": false
  },
  "active_project": "office_attendance",
  "projects": {
    "office_attendance": {
      "enabled": false,
      "log_in_out": true,
      "cooldown_seconds": 60
    },
    "temple_security": {
      "enabled": false,
      "alert_webhook": "http://alert-server/api/alert"
    },
    "retail_analytics": {
      "enabled": false
    }
  },
  "database": {
    "url": "sqlite:///storage/database.db",
    "faiss_index_path": "storage/embeddings/faiss_index.bin",
    "faiss_mapping_path": "storage/embeddings/id_mapping.json"
  },
  "models": {
    "detector_path": "Ai-models/det_10g.onnx",
    "recognition_path": "Ai-models/w600k_r50.onnx"
  },
  "storage": {
    "faces_dir": "storage/faces",
    "embeddings_dir": "storage/embeddings"
  },
  "camera": {
    "default_source": "0",
    "frame_width": 1280,
    "frame_height": 900,
    "rtsp_buffer_size": 1
  },
  "detector": {
    "input_width": 640,
    "input_height": 640,
    "score_threshold": 0.30,
    "nms_threshold": 0.40,
    "min_face_size": 15,
    "detect_person_objects": false
  },


  "quality": {
    "blur_threshold": 40.0,
    "min_eye_distance": 10.0,
    "max_pose_ratio": 0.50,
    "enhance_enabled": true,
    "enhance_contrast": true,
    "enhance_sharpness": true,
    "enhance_denoise": true
  },
  "tracker": {
    "track_high_thresh": 0.35,
    "track_low_thresh": 0.10,
    "new_track_thresh": 0.40,
    "track_buffer": 30,
    "match_thresh": 0.80
  },
  "recognition": {
    "embedding_dim": 512,
    "similarity_threshold": 0.45,
    "time_window": 3.0
  },

  "registration": {
    "sample_count": 6,
    "min_samples": 5,
    "preferred_samples": 6,
    "max_samples": 8,
    "identity_guard_enabled": true,
    "identity_threshold": 0.60,
    "target_similarity_threshold": 0.55,
    "target_reacquire_threshold": 0.60,
    "duplicate_similarity_threshold": 0.88,
    "duplicate_warning_threshold": 0.52,
    "target_lost_timeout": 3.0,
    "capture_interval": 1.0,
    "processing_fps": 8,
    "min_detection_confidence": 0.45,
    "min_face_width": 45,
    "min_face_height": 45,
    "min_sharpness": 18.0,
    "min_brightness": 25.0,
    "max_brightness": 235.0,
    "spatial_weight": 0.20,
    "identity_weight": 0.70,
    "confidence_weight": 0.10,
    "max_reference_embeddings": 5,
    "frontal_yaw_range": [-0.12, 0.12],
    "left_yaw_range": [-0.35, -0.12],
    "right_yaw_range": [0.12, 0.35]
  },

  "pipeline": {
    "capture_fps": 30,
    "stream_fps": 25,
    "detection_fps": 8,
    "recognition_fps": 3,
    "jpeg_quality": 90,
    "adaptive_quality": true,
    "camera_timeout": 10,
    "reconnect_interval": 5,
    "max_reconnect_attempts": 20,
    "gpu_enabled": "auto"
  },
  "visitors": {
    "match_high": 0.50,
    "match_low": 0.38,
    "registered_match_threshold": 0.45,
    "candidate_match_margin": 0.035,
    "visitor_profile_update_threshold": 0.65,
    "quality_poor_threshold": 0.35,
    "quality_matching_threshold": 0.48,
    "quality_enrollment_threshold": 0.55,
    "quality_avatar_threshold": 0.65,
    "min_face_width": 30,
    "min_face_height": 30,
    "max_abs_yaw": 0.22,
    "max_abs_pitch": 0.18,
    "min_blur_score": 15.0,
    "min_observations_for_new_visitor": 4,
    "within_track_consistency_thresh": 0.52,
    "max_samples_per_visitor": 6,
    "operational_day_start_hour": 0,
    "duplicate_flag_threshold": 0.48
  }
}

